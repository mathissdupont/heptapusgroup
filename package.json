{
  "name": "heptapusgroup.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "test:security": "node scripts/test-security.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "dev:local": "npm run db:up && npm run db:sync && npm run dev",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d db adminer",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "db:sync": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.1.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "xss": "^1.0.15",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "brace-expansion@1": "1.1.21"
  }
}
