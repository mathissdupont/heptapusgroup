# ═══════════════════════════════════════════════════════════════
# HEPTAPUS GROUP - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# 📦 DATABASE
# ⚠️ ÖNEMLI: Sunucuda zaten PostgreSQL varsa, onun connection string'ini kullanın
# Örnek: DATABASE_URL=postgresql://user:password@server-ip:5432/heptapus_db
DATABASE_URL=postgresql://heptapus:heptapus_secret_2026@localhost:5433/heptapus?schema=public

# Docker Compose PostgreSQL settings.
# The web container builds its internal DATABASE_URL from these values and uses db:5432.
POSTGRES_USER=heptapus
POSTGRES_PASSWORD=heptapus_secret_2026
POSTGRES_DB=heptapus
POSTGRES_LOCAL_PORT=5433
ADMINER_PORT=8081

# 🔐 AUTHENTICATION
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_DOMAIN=
# Only set this when your reverse proxy overwrites the header and direct access is blocked.
# Valid values: x-real-ip, cf-connecting-ip, x-forwarded-for (last hop).
TRUSTED_PROXY_IP_HEADER=

# 💳 STRIPE PAYMENT (ŞU ANDA TÜRKIYE'DE KULLANILMIYOR - DEVRE DIŞI)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxxxx_not_needed
STRIPE_WEBHOOK_SECRET=whsec_xxxxx_not_needed

# 📄 PDF WORKER SERVICE
PDF_WORKER_URL=http://localhost:8000
PDF_WORKER_KEY=your-secure-worker-key

# 🌍 APPLICATION
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
PORT=3000

# 🔌 CLOUDFLARE TURNSTILE (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ☁️ S3 / CLOUD STORAGE (Optional - Local storage will be used if disabled)
AWS_S3_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
# S3_ENDPOINT=
# S3_CDN_URL=
