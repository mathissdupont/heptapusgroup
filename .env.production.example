# ─────────────────────────────────────────────────────
# Heptapus Group — Production Environment Variables
# ─────────────────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayıp değerleri düzenleyin:
#   cp .env.production.example .env
# ─────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=heptapus
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE_YAZIN
POSTGRES_DB=heptapus

# ── Next.js Application ──
DATABASE_URL=postgresql://heptapus:BURAYA_GUCLU_SIFRE_YAZIN@db:5432/heptapus?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_DOMAIN=
APP_ORIGIN=https://heptapusgroup.com
# Set only behind a proxy which overwrites this header; block direct access to port 3000.
TRUSTED_PROXY_IP_HEADER=

# ── Cloudflare Turnstile ──
# Both real keys are required for public forms in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Port (opsiyonel) ──
PORT=3000
